%% 利用分布函数积分求解期望
function [trueValue,predictValue,predictValueHigh,predictValueLow,Prediction,MSE,MAE,MAPE] = Predict(Parameter,t,x,UDE,signal)
predictValue=zeros(length(x)-1,1);
predictValueHigh = zeros(length(x)-1,1);
predictValueLow =zeros(length(x)-1,1);
trueValue=x(2:end);
n=length(x);
        if strcmp(signal,'uncertain')
            % 定义符号变量 alpha_sym（在整个函数中使用）
            alpha_sym = sym('alpha_sym');
            for i = 2:n
                timelow=t(i-1);
                timeup=t(i);         
                initialValue = x(i-1);   
                % 使用 alpha_sym 计算路径
                path = alphaPath(Parameter, alpha_sym, timelow, timeup, initialValue, UDE);
                pathfunction = matlabFunction(path);
                % 检查函数是否需要输入参数
                if nargin(pathfunction) == 0
                    predictValue(i-1) = pathfunction();
                else
                    predictValue(i-1) = integral(pathfunction, 0, 1);
                end
                predictValueHigh(i-1) = alphaPath(Parameter, 0.95, timelow, timeup, initialValue, UDE);
                predictValueLow(i-1) = alphaPath(Parameter, 0.05, timelow, timeup, initialValue, UDE);
            end
                MSE = mean((trueValue - predictValue).^2);
                MAE = mean(abs(trueValue - predictValue));
                MAPE = mean(abs((trueValue - predictValue) ./ trueValue));
                % 预测下一时刻
                timelow = t(n);
                timeup = t(n)+1;
                initialValue = x(n);
                path_next = alphaPath(Parameter, alpha_sym, timelow, timeup, initialValue, UDE);
                pathfunction_next = matlabFunction(path_next);
                % 检查函数是否需要输入参数
                if nargin(pathfunction_next) == 0
                    Prediction = pathfunction_next();
                else
                    Prediction = integral(pathfunction_next, 0, 1);
                end
        else
        error('Unsupported signal type.');  
        end
end

function [trueValue,predictValue,predictValueHigh,predictValueLow,Prediction,MSE,MAE,MAPE] = Predict(Parameter,t,x,UDE,signal)
predictValue=zeros(length(x)-1,1); %存储计算出来的预测均值;
predictValueHigh = zeros(length(x)-1,1);
predictValueLow =zeros(length(x)-1,1);
trueValue=x(2:end);
% trueValue=x(1:end-1);
n=length(x);
        if strcmp(signal,'uncertain')
            % 定义符号变量 alpha_sym（在整个函数中使用）
            alpha_sym = sym('alpha_sym'); 
% 定义符号变量 alpha_sym（在整个函数中使用）
            alpha_sym = sym('alpha_sym');
            for i = 2:n
                timelow=t(i-1);
                timeup=t(i);         
                initialValue = x(i-1);   
                % 使用 alpha_sym 计算路径
                path = alphaPath(Parameter, alpha_sym, timelow, timeup, initialValue, UDE);
                pathfunction = matlabFunction(path);
                % 检查函数是否需要输入参数
                if nargin(pathfunction) == 0
                    predictValue(i-1) = pathfunction();
                else
                    predictValue(i-1) = integral(pathfunction, 0, 1);
                end
                        
%             for i = 2:n
%                 timelow=t(i-1);
%                 timeup=t(i);         
%                 % 预测初值用actual value  
%                 initialValue = x(i-1);   
% %                 % 预测初值用predicted value
% %                 if i == 2
% %                     initialValue = x(i-1);
% %                 else
% %                     initialValue = predictValue(i-2);
% %                 end
% 
%                 path = alphaPath(Parameter, alpha_sym, timelow, timeup, initialValue, UDE); % 计算路径
%                 % 将符号表达式转换为匿名函数
%                 pathfunction = matlabFunction(path);
%                 % 使用数值积分函数计算积分值
%                 predictValue(i-1) = integral(@(alpha) pathfunction(alpha), 0, 1);
%                 % 0.95预测值区间
                predictValueHigh(i-1) = alphaPath(Parameter, 0.95, timelow, timeup, initialValue, UDE);
                predictValueLow(i-1) = alphaPath(Parameter, 0.05, timelow, timeup, initialValue, UDE);
            end   
            end
                MSE = mean((trueValue - predictValue).^2); % 预测值和真实值的均方误差
                MAE = mean(abs(trueValue - predictValue)); % 预测值和真实值的平均绝对误差
                MAPE = mean(abs((trueValue - predictValue) ./ trueValue)); % 预测值和真实值的平均绝对百分比误差
                % -----------------预测下一时刻-----------------------------
                timelow = t(n);
                timeup = t(n)+1;
                initialValue = x(n);
                % int函数预测下一时刻期望值
                % sym alpha;
                % Prediction = alphaPath(Parameter, alpha_sym, timelow, timeup, initialValue, UDE);
                % Prediction = matlabFunction(Prediction);
                % Prediction = integral(@(alpha) Prediction(alpha), 0, 1);
                path_next = alphaPath(Parameter, alpha_sym, timelow, timeup, initialValue, UDE);
                pathfunction_next = matlabFunction(path_next);
                % 检查函数是否需要输入参数
                if nargin(pathfunction_next) == 0
                    Prediction = pathfunction_next();
                else
                    Prediction = integral(pathfunction_next, 0, 1);
                end    
        else
        error('Unsupported signal type.');  
        end
end

